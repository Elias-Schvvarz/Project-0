def find_index_of_nearest(number, the_list):
    if not the_list:
        return None

    best_index = 0
    min_differ = abs(the_list[0] - number)

    for i, num in enumerate(the_list):
        current_diff = abs(num - number)
        if current_diff < min_differ:
            min_differ = current_diff
            best_index = i

    return best_index


def filter_anagrams(target, candidates):
    target_sorted = sorted(target)
    return [item for item in candidates if sorted(item) == target_sorted]




from collections import Counter


def histo(rounds_count, roll_die):
    rolls = [roll_die() for _ in range(rounds_count)]
    counts = Counter(rolls)
    lines = []
    for side in range(1, 7):
        amount = counts[side]
        if amount > 0:
            bars = '#' * amount
            lines.append(f'{side}|{bars} {amount}')
        else:
            lines.append(f'{side}|')

    return '\n'.join(lines)



curry = lambda f: lambda x: lambda y: f(x, y)  # noqa: E731
compose = lambda f: lambda g: lambda x: f(g(x))  # noqa: E731
pair = lambda x: [x, x]  # noqa: E731
dup = lambda x: x + x  # noqa: E731

from functools import reduce
from operator import add

cmap = curry(map)
duplicate_chars = compose(''.join)(cmap(dup))
enlarge_horizontally = cmap(duplicate_chars)
enlarge_vertically = compose(curry(reduce)(add))(cmap(pair))
enlarge = compose(enlarge_vertically)(enlarge_horizontally)



from datetime import datetime
from collections import Counter

def get_men_counted_by_year(the_list):
    only_men = list(filter(lambda user: user['gender'] == 'male', the_list))
    year_list = list(map(lambda men: datetime.fromisoformat(men['birthday']).year, only_men))
    men_by_year = Counter(year_list)
    return men_by_year



