class AppError(Exception):
    pass


class ValidationError(AppError):
    def __init__(self, field, message):
        self.field = field
        super().__init__(f"{field}: {message}")


class RequiredFieldError(ValidationError):
    def __init__(self, field):
        super().__init__(field, "is required")


class InvalidTypeError(ValidationError):
    def __init__(self, field, expected, got):
        self.expected = expected
        self.got = got
        message = f"expected {expected.__name__}, got {got.__name__}"
        super().__init__(field, message)


def validate(data, schema):
    for field, expected_type in schema.items():
        if field not in data:
            raise RequiredFieldError(field)
        
        value = data[field]
        if type(value) is not expected_type:
            raise InvalidTypeError(field, expected_type, type(value))
            
    return True



class PasswordValidator():
    OPTIONS = {
        'min_len': 8,
        'contain_numbers': False,
        }

    def __init__(self, **options):
        self.options = {**self.OPTIONS, **options}

    def validate(self, password):
        errors = {}
        if len(password) < self.options['min_len']:
            errors['min_len'] = 'too small'
        if self.options['contain_numbers'] and not self._has_number(password):
            errors['contain_numbers'] = 'should contain at least one number'
        return errors

    def _has_number(self, password):
        return any(char.isdigit() for char in password)



class Truncater:
    OPTIONS = {
        'separator': '...',
        'length': 200,
    }

    def __init__(self, **options):
        self.options = {**self.OPTIONS, **options}

    def truncate(self, text, **options):
        current_options = {**self.options, **options}
        length = current_options['length']
        separator = current_options['separator']

        if len(text) > length:
            return f"{text[:length]}{separator}"
        return text



from urllib.parse import parse_qs, urlparse


class Url:
    def __init__(self, url_string):
        self._raw_url = url_string
        self._parsed = urlparse(url_string)

    def get_scheme(self):
        return self._parsed.scheme

    def get_hostname(self):
        return self._parsed.hostname

    def get_query_params(self):
        return parse_qs(self._parsed.query)

    def get_query_param(self, key, default=None):
        params = self.get_query_params()
        if key in params:
            return params[key][0]
        return default

    def __eq__(self, other):
        if not isinstance(other, Url):
            return False
        return self._raw_url == other._raw_url



from collection import Collection


def format(data):
    c = Collection(data)
    return (
        c.map_(lambda item: {
            'name': item['name'].strip().lower(),
            'country': item['country'].strip().lower(),
        })
        .unique()
        .sort_by(lambda item: item['name'])
        .group_by(lambda item: (item['country'], item['name']))
        .sort_by(lambda item: list(item.keys())[0])
        .all()
    )
