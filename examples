def compress_images(tree):
    children = get_children(tree)

    def compress_node(node):
        name = get_name(node)
        if is_file(node) and name.endswith(".jpg"):
            new_meta = copy.deepcopy(get_meta(node))
            if "size" in new_meta:
                new_meta["size"] //= 2
            return mkfile(name, new_meta)
        return copy.deepcopy(node)

    new_children = [compress_node(child) for child in children]
    new_meta = copy.deepcopy(get_meta(tree))

    return mkdir(get_name(tree), new_children, new_meta)



def downcase_file_names(node):
    name = get_name(node)
    new_meta = copy.deepcopy(get_meta(node))

    if is_file(node):
        return mkfile(name.lower(), new_meta)

    children = get_children(node)
    new_children = [downcase_file_names(child) for child in children]

    return mkdir(name, new_children, new_meta)



def get_hidden_files_count(node):
    if is_file(node):
        name = get_name(node)
        return 1 if name.startswith('.') else 0
    children = get_children(node)
    descendant_counts = list(map(get_hidden_files_count, children))
    return sum(descendant_counts)



