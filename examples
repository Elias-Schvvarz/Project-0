def find_files_by_name(tree, substr):
    def walk(node, ancestry):
        name = get_name(node)
        
        if is_file(node):
            if substr in name:
                return [os.path.join(ancestry, name)]
            return []

        new_ancestry = os.path.join(ancestry, name)
        children = get_children(node)
        output = [walk(child, new_ancestry) for child in children]

        return flatten(output)
    return walk(tree, '')



