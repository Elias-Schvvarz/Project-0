import math

def make(input_numer, input_denom):
    gcd = math.gcd(input_numer, input_denom)
    return {
        "numer": int(input_numer // gcd),
        "denum": int(input_denom // gcd),
    }

def get_numer(rational):
    return rational["numer"]

def get_denom(rational):
    return rational["denum"]

def add(rational_1, rational_2):
    numer_1 = get_numer(rational_1)
    numer_2 = get_numer(rational_2)
    denom_1 = get_denom(rational_1)
    denom_2 = get_denom(rational_2)

    new_numer = numer_1 * denom_2 + numer_2 * denom_1
    new_denum = denom_1 * denom_2

    return make(new_numer, new_denum)



def to_str(rat):
    return f"{get_numer(rat)}/{get_denom(rat)}"



def sequence_sum(begin, end):
    if begin > end:
        return None

    if begin == end:
        return begin

    return begin + sequence_sum(begin + 1, end)



def smallest_divisor(number):
    if number == 1:
        return 1
    
    def inner(acc):
        if number % acc == 0:
            return acc
        return inner(acc + 1)

    return inner(2)



